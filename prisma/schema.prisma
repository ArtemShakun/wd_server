generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique 
  password  String           
  username  String?          
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutPrograms  WorkoutProgram[]
  workoutDays  WorkoutDay[]
}

enum MuscleRole {
  PRIMARY    // червоний - основне навантаження
  SECONDARY  // помаранчевий - додаткове навантаження  
  STABILIZER // зелений - стабілізатори
}

enum Category {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  ABS
  OBLIQUES
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  TRAPS
}

model Exercise {
  id          String   @id @default(uuid())
  name        String   @unique
  category    Category
  muscles     ExerciseMuscle[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programExercises         ProgramExercise[]
  workoutDayExercises  WorkoutDayExercise[]
}

model ExerciseMuscle {
  id         String      @id @default(uuid())
  exerciseId String
  muscle     Category
  role       MuscleRole

  exercise   Exercise    @relation(fields: [exerciseId], references: [id])

  @@unique([exerciseId, muscle])
}

// 1. Шаблон програми тренування (створюється юзером заздалегідь)
model WorkoutProgram {
  id          String            @id @default(uuid())
  userId      String
  name        String            // Наприклад: "День А (Верх тіла)"
  
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   ProgramExercise[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// Вправи всередині шаблону програми
model ProgramExercise {
  id         String         @id @default(uuid())
  programId  String
  exerciseId String
  order      Int            // Порядок вправи в програмі
  
  program    WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
}

// 2. Конкретний тренувальний день у календарі юзера
model WorkoutDay {
  id        String                   @id @default(uuid())
  userId    String
  date      DateTime                 @default(now())
  name      String                   // Наприклад: "Тренування грудей"
  
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutDayExercise[]

  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
}

// Вправа у конкретному тренуванні дня (дані тут автономні і не ламають шаблон при зміні)
model WorkoutDayExercise {
  id         String         @id @default(uuid())
  sessionId  String
  exerciseId String
  order      Int
  
  session    WorkoutDay @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  sets       WorkoutSet[]
}

// Підходи (сети) для вправи у конкретний день
model WorkoutSet {
  id                String                 @id @default(uuid())
  sessionExerciseId String
  setNumber         Int                    // Номер підходу (1, 2, 3...)
  weight            Float                  // Робоча вага
  reps              Int                    // Кількість повторень
  
  sessionExercise   WorkoutDayExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
}