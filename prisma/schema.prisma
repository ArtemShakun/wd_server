

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique 
  password  String           
  username  String?          
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}